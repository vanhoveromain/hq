{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.ownhq.app" }],
      "destination": "/sporthq3",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sport.ownhq.app" }],
      "destination": "/sporthq3"
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "sport.ownhq.app" }],
      "destination": "/sporthq3/:path+"
    }
  ]
}
