# Copy this file to .env and fill in the values. .env is gitignored: never commit it.
# These are only for the Supabase CLI on your computer. Nothing here goes into the browser app.

# Project reference: the random id in your project URL (https://<ref>.supabase.co)
SUPABASE_PROJECT_REF=

# Database password you chose when creating the project
SUPABASE_DB_PASSWORD=

# Personal access token for the CLI (Account > Access Tokens)
SUPABASE_ACCESS_TOKEN=

# NEVER put the secret / service_role key in this project's browser code.
